{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Interview Cockpit Leitfaden Version 1",
  "type": "object",
  "required": [
    "version",
    "title",
    "sections"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "guest": {
      "type": "string",
      "maxLength": 200
    },
    "introSeconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 7200,
      "default": 180
    },
    "outroSeconds": {
      "type": "integer",
      "minimum": 10,
      "maximum": 7200,
      "default": 120
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "questions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60,
            "not": {
              "enum": [
                "__intro",
                "__outro",
                "__proto__",
                "constructor",
                "prototype"
              ]
            }
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "color": {
            "enum": [
              "mint",
              "blue",
              "amber",
              "violet",
              "rose"
            ]
          },
          "questions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "type": "object",
              "required": [
                "id",
                "text",
                "seconds"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "not": {
                    "enum": [
                      "__intro",
                      "__outro",
                      "__proto__",
                      "constructor",
                      "prototype"
                    ]
                  }
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "seconds": {
                  "type": "integer",
                  "minimum": 10,
                  "maximum": 7200
                },
                "essential": {
                  "type": "boolean"
                },
                "transition": {
                  "type": "string",
                  "maxLength": 2000
                },
                "hint": {
                  "type": "string",
                  "maxLength": 1000
                },
                "followUps": {
                  "type": "array",
                  "maxItems": 12,
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$comment": "Zusätzlich validiert die App eindeutige Bereichs- und Fragen-IDs sowie maximal 200 Fragen insgesamt."
}